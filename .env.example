# =====================================================================
# CommitX Environment Configuration
# Copy this file to .env for local overrides
# =====================================================================

# --- Backend Server Configuration ---
# Port for backend Express API server (default: 3001)
PORT=3001

# Host binding for backend Express server (default: 0.0.0.0)
HOST=0.0.0.0

# --- Frontend & Vite Configuration ---
# Port for Vite local development server (`npm run dev`)
VITE_PORT=3000

# Port for Vite preview server (`npm run preview`)
VITE_PREVIEW_PORT=4173

# Target URL for Vite dev/preview proxy to backend API (default: http://localhost:3001)
VITE_API_TARGET=http://localhost:3001

# Optional standalone API base URL for client requests (leave blank to use relative same-origin / proxy)
# Example for decoupled deployments: https://api.yourdomain.com
VITE_API_BASE_URL=

# --- AI Engine Configuration ---
# Gemini AI API Key (Optional: if provided, uses Gemini 1.5 Flash for live error analysis;
# if omitted, CommitX seamlessly falls back to the deterministic local offline debugging engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative fallback environment variable for AI API key
AI_API_KEY=your_ai_api_key_here
